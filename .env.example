# Copy to .env and fill in. Never commit .env.

# ── Required (live mode) ───────────────────────────────────────────────────
# SEC EDGAR needs no API key, but SEC requires a descriptive User-Agent with contact info (placeholder below).
SEC_USER_AGENT=your-app-name your-email@example.com
GROQ_API_KEY=                # https://console.groq.com  (free: ~1000 requests/day, very fast) — primary LLM
OPENROUTER_API_KEY=          # https://openrouter.ai/keys  — fallback LLMs (':free' models only)

# ── LLM fallback chain (free models only; first working one wins) ──────────
# LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# ALLOW_PAID_MODELS=false    # paid OpenRouter models are rejected at startup unless this is true

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# TOP_N_TRADES=5
# MIN_TRADE_NOTIONAL=10000          # ignore tickers with less gross open-market $ than this
# RANK_WINDOW_DAYS=14               # ranking window, measured on EDGAR acceptance time
# EDGAR_INITIAL_LOOKBACK_DAYS=14    # first run (no watermark) starts this many days back
# EDGAR_MAX_FILINGS_PER_RUN=0       # 0 = unlimited (a 2-week catch-up is ~10-15k filings)
# EDGAR_FIRST_RUN_MAX_FILINGS=20000
# EDGAR_MAX_RUNTIME_MINUTES=150     # stop cleanly before the CI job timeout; 0 = no limit
