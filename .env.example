# Copy to .env and fill in. Never commit .env.

# ── Required (live mode) ───────────────────────────────────────────────────
SEC_API_KEY=                 # https://sec-api.io  (free tier works)
APIFY_API_TOKEN=             # https://console.apify.com → Settings → Integrations
GROQ_API_KEY=                # https://console.groq.com  (free: ~1000 requests/day, very fast) — primary LLM
OPENROUTER_API_KEY=          # https://openrouter.ai/keys  — fallback LLMs (':free' models only)

# ── LLM fallback chain (free models only; first working one wins) ──────────
# LLM_CHAIN=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,openrouter:nvidia/nemotron-3-ultra-550b-a55b:free
# ALLOW_PAID_MODELS=false    # paid OpenRouter models are rejected at startup unless this is true

# ── LightRAG knowledge graph (can also be toggled in the sidebar) ──────────
ENABLE_LIGHTRAG=true
# EMBEDDING_PROVIDER=local   # local (fastembed, default) | openrouter

# ── Pipeline tuning ─────────────────────────────────────────────────────────
# TOP_N_TRADES=5
# MIN_TRADE_NOTIONAL=10000          # ignore tickers with less gross open-market $ than this
# FILING_LOOKBACK_HOURS=24
# TWEETS_PER_TICKER=40
# TWEET_LOOKBACK_DAYS=7
# APIFY_MONTHLY_BUDGET_USD=2.0      # hard cap checked before every scrape
# OTEL_CONSOLE=false                # true prints every telemetry span to the terminal
